# Copy to .env and fill in from https://discord.com/developers/applications
# Your Application ID (public; also embedded in the client bundle).
VITE_DISCORD_CLIENT_ID=
# Same Application ID, read by the server.
DISCORD_CLIENT_ID=
# OAuth2 Client Secret. Server-only: never expose it to the client or commit it.
DISCORD_CLIENT_SECRET=

# Where the client exchanges its OAuth code. Same-origin by default.
# Set to `none` on a static host such as GitHub Pages: Discord still shows the
# Activity on profiles, but custom Rich Presence details/timer need a server.
VITE_TOKEN_ENDPOINT=/api/token

# Optional Rich Presence art: an uploaded Rich Presence asset key or an https image URL.
VITE_PRESENCE_LARGE_IMAGE=

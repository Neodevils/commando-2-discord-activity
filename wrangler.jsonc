{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "commando-2-discord-activity",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}

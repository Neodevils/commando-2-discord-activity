{
  "name": "commando-2-discord-activity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Commando 2 (Flash) played in Discord through Ruffle, with Discord Activity auth and Rich Presence.",
  "scripts": {
    "postinstall": "node scripts/sync-ruffle.mjs",
    "dev": "node scripts/sync-ruffle.mjs && vite",
    "build": "node scripts/sync-ruffle.mjs && tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "npm run build && npm start",
    "deploy:cf": "npm run build && wrangler deploy",
    "dev:cf": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@ruffle-rs/ruffle": "^0.7.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "wrangler": "^4.160.0"
  }
}
